# ================= LUNA =================
# Copy to .env and run ./setup.sh (it fills the host-specific values for you).

# ---- Gemini (Google AI Studio) — REQUIRED ----
# https://aistudio.google.com/apikey   (an app subscription is NOT API access)
GEMINI_API_KEY=your-key-here
GOOGLE_API_KEY=your-key-here

# ---- host identity (auto-detected by setup.sh) ----
HOST_UID=1000
HOST_GID=1000
HERMES_UID=1000
HERMES_GID=1000
HOST_RUNTIME_DIR=/run/user/1000

# ---- devices (auto-detected by setup.sh) ----
CAMERA_DEVICE=/dev/video0

# ---- dashboard ----
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=luna
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me

# ---- ports on the host (loopback only) ----
DASHBOARD_PORT=9119
API_PORT=8642

# ---- image + resources ----
HERMES_VERSION=v2026.8.19
MEM_LIMIT=2g
MEMSWAP_LIMIT=3g
CPUS=2.0

# ---- optional: web search (pick one; Hermes does NOT use Gemini grounding) ----
# TAVILY_API_KEY=
# EXA_API_KEY=
# FIRECRAWL_API_KEY=

# NOTE: model / personality / voice are NOT env vars.
# They live in data/config.yaml -> `docker compose exec luna hermes config set ...`
